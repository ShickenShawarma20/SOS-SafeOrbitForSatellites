{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/api/v1/tracking/fleet",
      "destination": "/api/v1/tracking/fleet"
    },
    {
      "source": "/api/v1/tracking/status",
      "destination": "/api/v1/tracking/status"
    },
    {
      "source": "/api/v1/tracking/:noradId/position",
      "destination": "/api/v1/[...path]"
    },
    {
      "source": "/api/v1/tracking/:noradId/trajectory",
      "destination": "/api/v1/[...path]"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/[...path]"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
