{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.(css|js|jpg|jpeg|png|gif|svg|mp4|ico|json|woff|woff2|ttf|eot))", "dest": "/public/$1" },
    { "src": "/(index|landing|analytics|autopilot|conjunction|console|debris|groundstations|maneuvers|orbits|reports|satellite|settings|tracking)", "dest": "/public/$1.html" },
    { "src": "/", "dest": "/public/landing.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "outputDirectory": "public"
}
