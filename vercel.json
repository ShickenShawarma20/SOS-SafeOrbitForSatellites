{
  "version": 2,
  "builds": [
    {
      "src": "server/dist/bundle.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "public/**",
        "bundle": false
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server/dist/bundle.js"
    }
  ]
}
